# ==============================================================================
# Thesis regressions: OFDI flows/stocks, linear and log-log specifications
# ==============================================================================

# ---- Setup -------------------------------------------------------------------
rm(list = ls())

suppressPackageStartupMessages({
  library(tidyverse)
  library(readxl)
  library(car)
  library(stargazer)
  library(here)
})

# ---- I/O ---------------------------------------------------------------------
data_path <- here::here("Downloads", "AV_Data.xlsx")   
av_data <- read_excel(data_path)

# If you really want a viewer in interactive sessions:
if (interactive()) View(av_data)

# ---- Variables / transforms ---------------------------------------------------
# Keep everything in the data frame; avoid creating lots of globals.
av_data <- av_data %>%
  mutate(
    # convenience renames (optional)
    INR    = Infrastructure,
    INF    = Inflation,
    RES    = Resources,
    FUEL   = fuels,
    OIL    = oilrent,
    GDP_gr = GDP_growth,
    
    # dependent variables
    LOFDI       = log(OFDI_flow + 13),
    LOFDI_stock = log(OFDI_stock),
    
    # covariates (levels)
    # GDP, WGI, ORES, REE assumed present in the input
    
    # covariates (logs)
    LGDP    = log(GDP),
    LGDP_gr = log(GDP_gr + 5),
    LWGI    = log(WGI + 2),
    LINR    = log(INR),
    LINF    = log(INF + 1),
    LORES   = log(ORES + 1),
    LRES    = log(RES),
    LFUEL   = log(FUEL + 1),
    LOIL    = log(OIL + 1),
    LREE    = log(REE + 1)
  )

# ---- Diagnostics: VIF ---------------------------------------------------------
ols_vif <- lm(
  LOFDI ~ LGDP + LGDP_gr + LWGI + LINR + LINF + LORES + LREE,
  data = av_data
)
car::vif(ols_vif)

# ---- Descriptive tables -------------------------------------------------------
# NOTE: Your original script referenced `Tables_thesis` but never defined it.
# The blocks below are kept, but guarded to avoid hard errors.

stargazer(
