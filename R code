    title = "Table 5. Correlation Matrix", digits = 6,
    out = "Correlations.html"
  )
  stargazer(
    Tables_thesis, type = "html", summary = FALSE,
    title = "Table 6. Variance Inflation Factors", digits = 4,
    out = "vif.html"
  )
}

# ---- Model helpers ------------------------------------------------------------
fit_models <- function(dv, specs, data) {
  # specs: named list of RHS strings
  map(specs, ~ lm(as.formula(paste(dv, "~", .x)), data = data))
}

export_stargazer <- function(models, file, title) {
  stargazer(
    models,
    type = "html",
    title = title,
    align = TRUE,
    header = FALSE,
    ci = FALSE,
    star.cutoffs = c(0.1, 0.05, 0.01, 0.001),
    omit.stat = c("f"),
    out = file
  )
}

# ---- Log-log models (DV: LOFDI) ----------------------------------------------
log_specs_flow <- list(
  OLS_log  = "LGDP + LGDP_gr + LWGI + LINR + LINF + LORES",
  OLS_log1 = "LGDP + LGDP_gr + LWGI + LINR + LINF + LORES + LREE",
  OLS_log2 = "LGDP + LGDP_gr + LWGI + LINR + LINF + LREE",
  OLS_log3 = "LGDP + LGDP_gr + LWGI + LINR + LINF + LORES + LFUEL",
  OLS_log4 = "LGDP + LGDP_gr + LWGI + LINR + LINF + LORES + LFUEL + LREE",
  OLS_log5 = "LGDP + LGDP_gr + LWGI + LINR + LINF + LFUEL + LREE",
  OLS_log6 = "LGDP + LGDP_gr + LWGI + LINR + LINF + LRES + LREE",
  OLS_log7 = "LGDP + LGDP_gr + LWGI + LINR + LINF + LRES",
  OLS_log8 = "LREE",
  OLS_log9 = "LORES"
)

models_log_flow <- fit_models("LOFDI", log_specs_flow, av_data)

# Print summaries (optional)
walk(models_log_flow, summary)

# Export selected models to a single table (as in your original)
export_stargazer(
  models = list(
    models_log_flow$OLS_log,
    models_log_flow$OLS_log1,
    models_log_flow$OLS_log2,
    models_log_flow$OLS_log6,
    models_log_flow$OLS_log8,
    models_log_flow$OLS_log9
  ),
  file  = "aa_table.html",
  title = "Table 7. Logarithmic Regression Models Summary"
)

